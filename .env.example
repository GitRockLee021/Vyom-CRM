# Copy to your deployment platform's environment settings (or to server/.env for local dev).

# Postgres connection string (required). Example (Supabase):
# postgresql://user:password@host:5432/postgres
DATABASE_URL=

# Port used by the API server. Render injects PORT automatically; local default is 5001.
PORT=5001

# Secret used to sign JWT auth tokens. Use a long random string.
JWT_SECRET=

# Allowed browser origin for cross-origin API calls.
# Locally: http://localhost:5174
# In production (same-origin served from the same service): your render URL, e.g. https://vyom-crm.onrender.com
CORS_ORIGIN=http://localhost:5174

# Base URL used to build password-reset links.
# Locally: http://localhost:5174
# In production: your render URL, e.g. https://vyom-crm.onrender.com
CLIENT_URL=http://localhost:5174

# Optional. Set to "false" only if your database connection does not require SSL.
# DATABASE_SSL=true

# Optional WhatsApp (Meta Cloud API) credentials. These are a FALLBACK — the
# preferred way is to paste them into the CRM via the WhatsApp page so each
# tenant can manage its own connection.
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_GRAPH_VERSION=v21.0